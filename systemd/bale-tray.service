[Unit]
Description=Bale tray icon
After=graphical-session.target bale.service

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# اگر پنل هنوز بالا نیامده باشد آیکون در خلأ ثبت می‌شود (مسابقهٔ لاگین) — حداکثر ۹۰ ثانیه صبر
ExecStartPre=/bin/sh -c 'i=0; until pgrep -x xfce4-panel >/dev/null 2>&1; do [ $i -ge 90 ] && break; sleep 1; i=$((i+1)); done'
ExecStart=/usr/bin/python3 %h/apps/bale-wrapper/tray.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
