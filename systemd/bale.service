[Unit]
Description=Bale messenger (electron wrapper)
After=graphical-session.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/apps/bale-wrapper/node_modules/electron/dist/electron --no-sandbox %h/apps/bale-wrapper
WorkingDirectory=%h/apps/bale-wrapper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
